{
  "name": "nova-ai-assistant",
  "productName": "Nova AI Assistant",
  "version": "0.1.0",
  "description": "Cross-platform AI assistant desktop app with macOS universal and Windows support.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "openai": "^4.52.0",
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/generative-ai": "^0.3.0",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.nova.aiassistant",
    "productName": "Nova AI Assistant",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets"
    }
  },
  "devDependencies": {
    "electron": "^26.4.0",
    "electron-builder": "^24.6.0"
  }
}
